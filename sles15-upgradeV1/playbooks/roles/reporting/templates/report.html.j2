<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Reporte SLES Upgrade - {{ stage_report.hostname }} - {{ stage_report.stage }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Arial, sans-serif; margin: 2rem; color: #1a1a1a; background: #fafafa; }
  h1 { font-size: 1.4rem; margin-bottom: 0.2rem; }
  h2 { font-size: 1.1rem; margin-top: 2rem; border-bottom: 1px solid #ddd; padding-bottom: 0.3rem; }
  .subtitle { color: #555; margin-top: 0; }
  table { border-collapse: collapse; width: 100%; margin-top: 0.5rem; background: #fff; }
  th, td { border: 1px solid #ddd; padding: 0.5rem 0.7rem; text-align: left; font-size: 0.92rem; vertical-align: top; }
  th { background: #f0f0f0; }
  .badge { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 0.8rem; font-weight: 600; font-size: 0.85rem; color: #fff; }
  .badge-OK { background: #2e7d32; }
  .badge-WARNING { background: #b8860b; }
  .badge-FAILED { background: #c62828; }
  .badge-NOT_CHECKED { background: #757575; }
  pre { background: #111; color: #eee; padding: 0.8rem; overflow-x: auto; font-size: 0.8rem; white-space: pre-wrap; word-break: break-word; }
  .summary-box { padding: 1rem; border-radius: 0.4rem; margin-bottom: 1rem; border: 1px solid #ddd; background: #fff; }
  .muted { color: #777; font-size: 0.85rem; }
</style>
</head>
<body>

<h1>Reporte de upgrade SLES 15 — {{ stage_report.hostname }}</h1>
<p class="subtitle">Etapa: <strong>{{ stage_report.stage }}</strong> · Acción solicitada: {{ stage_report.action }} · Fase: <strong>{{ stage_report.phase | default('both') }}</strong> · Generado: {{ stage_report.finished_at | default('N/D') }}</p>
{% if (stage_report.phase | default('')) == 'prepare' %}
<p class="muted">Esta corrida solo PREPARÓ los repositorios (updatestack real + repos de destino habilitados) — no ejecutó dup -D, dup, ni reinicio. Ejecute la fase "apply" para continuar con la migración real.</p>
{% elif (stage_report.phase | default('')) == 'apply' %}
<p class="muted">Esta corrida asume que una fase "prepare" previa ya dejó los repos de destino habilitados; no repite backup/deshabilitar preexistentes/updatestack (ver esos datos en el reporte de esa fase anterior).</p>
{% elif (stage_report.phase | default('')) == 'skip' %}
<p class="muted">upgrade_mode=full con fase=prepare: esta etapa no modificó nada — full prepara y aplica cada salto internamente al ejecutar la fase "apply"/"both".</p>
{% endif %}

<div class="summary-box">
  <p><strong>Resultado final de la etapa:</strong>
    <span class="badge badge-{{ stage_report.status }}">{{ stage_report.status }}</span>
  </p>
  <table>
    <tr><th>Hostname</th><td>{{ stage_report.hostname }}</td><th>FQDN</th><td>{{ stage_report.fqdn | default('N/D') }}</td></tr>
    {% if (stage_report.crq | default('')) | length > 0 or (stage_report.lote | default('')) | length > 0 or (stage_report.ambiente | default('')) | length > 0 %}
    <tr><th>CRQ/RFC</th><td>{{ stage_report.crq | default('N/D') }}</td><th>Lote</th><td>{{ stage_report.lote | default('N/D') }}</td></tr>
    <tr><th>Ambiente</th><td colspan="3">{{ stage_report.ambiente | default('N/D') }}</td></tr>
    {% endif %}
    <tr><th>Inicio</th><td>{{ stage_report.started_at | default('N/D') }}</td><th>Fin</th><td>{{ stage_report.finished_at | default('N/D') }}</td></tr>
    <tr><th>SP inicial</th><td>{{ stage_report.sp_inicial | default('N/D') }}</td><th>SP objetivo</th><td>{{ stage_report.sp_objetivo | default('N/D') }}</td></tr>
    <tr><th>SP final detectado</th><td>{{ stage_report.sp_final | default('N/D') }}</td><th>dup aplicado</th><td>{{ stage_report.migration.dup_applied | default(false) }}</td></tr>
    <tr><th>Kernel antes</th><td>{{ stage_report.kernel_antes | default('N/D') }}</td><th>Kernel después</th><td>{{ stage_report.kernel_despues | default('N/D') }}</td></tr>
    {% set _sd_antes = stage_report.systemd_antes | default({}) %}
    {% set _sd_despues = stage_report.systemd_despues | default({}) %}
    <tr>
      <th>systemd antes (<code>is-system-running</code>)</th>
      <td><span class="badge badge-{{ 'WARNING' if (_sd_antes.unidades_failed | default([])) | length > 0 else 'OK' }}">{{ _sd_antes.estado | default('N/D') }}</span>{% if (_sd_antes.unidades_failed | default([])) | length > 0 %} — <code>--failed</code>: {{ _sd_antes.unidades_failed | join(', ') }}{% endif %}</td>
      <th>systemd después</th>
      <td><span class="badge badge-{{ 'WARNING' if (_sd_despues.unidades_failed | default([])) | length > 0 else 'OK' }}">{{ _sd_despues.estado | default('N/D') }}</span>{% if (_sd_despues.unidades_failed | default([])) | length > 0 %} — <code>--failed</code>: {{ _sd_despues.unidades_failed | join(', ') }}{% endif %}</td>
    </tr>
  </table>
  <p class="muted">"systemd" es informativo (<code>systemctl is-system-running</code> /
     <code>systemctl --failed</code>): nunca decide por sí solo el resultado de la etapa
     — un servicio fallido puede ser irrelevante o puede ser algo real; revisar
     manualmente si aparece alguna unidad listada arriba.</p>
  {% if stage_report.failure_stage %}
  <p><strong>Etapa/check exacto que falló:</strong> {{ stage_report.failure_stage }}</p>
  {% endif %}
</div>

{% if stage_report.precheck %}
<h2>Prechecks</h2>
<table>
  <tr><th>Chequeo</th><th>Estado</th><th>Detalle</th></tr>
  {% for c in stage_report.precheck.checks | default([]) %}
  <tr><td>{{ c.name }}</td><td><span class="badge badge-{{ c.status }}">{{ c.status }}</span></td><td>{{ c.detail }}</td></tr>
  {% endfor %}
</table>
{% if stage_report.precheck.repo_inventory %}
<h3>Inventario de repositorios al momento del precheck</h3>
<table>
  <tr><th>Alias</th><th>Nombre</th><th>Habilitado</th></tr>
  {% for r in stage_report.precheck.repo_inventory %}
  <tr><td>{{ r.alias }}</td><td>{{ r.name }}</td><td>{{ 'Sí' if r.enabled else 'No' }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}

{% if stage_report.preflight %}
<h2>Preflight real (VALIDATE) contra Foreman/Katello</h2>
<p class="muted">
  Aísla los archivos .repo con <code>--reposd-dir &lt;directorio temporal&gt;</code>
  (no se afirma que aísle también servicios de Zypper u otros componentes). Nunca usa
  <code>refresh -s</code>/<code>--services</code>: solo refresca los alias Foreman
  exactos agregados para esta prueba. El directorio temporal se elimina siempre al
  finalizar (éxito o fallo).
</p>
<p><strong>Soportado en este host:</strong> {{ stage_report.preflight.supported | default('N/D') }}
   &nbsp;·&nbsp; <strong>Resultado global:</strong>
   <span class="badge badge-{{ stage_report.preflight.status | default('NOT_CHECKED') }}">{{ stage_report.preflight.status | default('NOT_CHECKED') }}</span></p>
{% if stage_report.preflight.status == 'NOT_CHECKED' or stage_report.preflight.status == 'FAILED' %}
<p><strong>Este resultado NO debe interpretarse como una validación exitosa.</strong></p>
{% endif %}
{% if stage_report.preflight.origin %}
<h3>Verificación del Service Pack de origen (refresh no destructivo)</h3>
<p><span class="badge badge-{{ stage_report.preflight.origin.status | default('NOT_CHECKED') }}">{{ stage_report.preflight.origin.status | default('NOT_CHECKED') }}</span></p>
<pre>{{ stage_report.preflight.origin.output_summary | default('sin salida registrada') }}</pre>
{% endif %}
<h3>Verificación del Service Pack de destino (refresh + dup -D)</h3>
<pre>{{ stage_report.preflight.output_summary | default('sin salida registrada') }}</pre>
{% endif %}

{% if stage_report.repos %}
<h2>Repositorios</h2>
{% if stage_report.repos.phase_note %}
<p class="muted">{{ stage_report.repos.phase_note }}</p>
{% endif %}
<table>
  <tr><th>Directorio de respaldo</th><td colspan="3">{{ stage_report.repos.backup_dir | default('N/D') }}</td></tr>
  <tr><th>Habilitados antes (preexistentes)</th><td>{{ (stage_report.repos.repos_enabled_before | default([])) | join(', ') or 'ninguno' }}</td>
      <th>Ya deshabilitados antes</th><td>{{ (stage_report.repos.repos_disabled_before | default([])) | join(', ') or 'ninguno' }}</td></tr>
  <tr><th>Deshabilitados por esta automatización</th><td colspan="3">{{ (stage_report.repos.repos_disabled_by_upgrade | default([])) | join(', ') or 'ninguno' }}</td></tr>
  {% if (stage_report.repos.repos_leftover_removed_before_start | default([])) | length > 0 %}
  <tr><th>Huérfanos retirados (de una ejecución anterior fallida)</th><td colspan="3">{{ stage_report.repos.repos_leftover_removed_before_start | join(', ') }}</td></tr>
  {% endif %}
  <tr><th>Temporales Foreman creados</th><td colspan="3">{{ (stage_report.repos.repos_temporary_created | default([])) | join(', ') or 'ninguno' }}</td></tr>
  <tr><th>Temporales Foreman retirados</th><td colspan="3">{{ (stage_report.repos.repos_temporary_removed | default([])) | join(', ') or 'ninguno' }}</td></tr>
  <tr><th>Habilitados al final de la etapa</th><td colspan="3">{{ (stage_report.repos.repos_enabled_after | default([])) | join(', ') or 'ninguno' }}</td></tr>
  <tr><th>Inventario final confiable</th><td colspan="3">
      <span class="badge badge-{{ stage_report.repos.final_inventory_status | default('NOT_CHECKED') }}">{{ stage_report.repos.final_inventory_status | default('NOT_CHECKED') }}</span>
      — {{ stage_report.repos.final_inventory_detail | default('N/A') }}</td></tr>
  <tr><th>Nota de limpieza</th><td colspan="3">{{ stage_report.repos.cleanup_note | default('N/A') }}</td></tr>
</table>
<p class="muted">Los repositorios preexistentes nunca se borran y nunca se reactivan
   automáticamente: eso queda a cargo del proceso corporativo de parchado.</p>
{% endif %}

{% if stage_report.migration %}
<h2>Resultado de la migración</h2>
<p><strong>dup aplicado:</strong> {{ stage_report.migration.dup_applied | default(false) }}
   <span class="muted">(esta evidencia se conserva aunque el reinicio posterior falle)</span></p>
<h3>Gate obligatorio dup -D (inmediatamente antes del dup real)</h3>
<pre>{{ stage_report.migration.dry_run_gate_output | default('N/A (no se llegó a ejecutar)') }}</pre>
<h3>dup real</h3>
<pre>{{ stage_report.migration.output_summary | default('N/A (no aplicado)') }}</pre>
{% if (stage_report.migration.output_full | default('')) | length > (stage_report.migration.output_summary | default('')) | length %}
<p class="muted">La salida de arriba está recortada para que el reporte siga siendo legible. La salida COMPLETA sin recortar del <code>dup</code> real quedó guardada junto a este reporte, mismo nombre, con extensión <code>.dup_full.log</code>.</p>
{% endif %}
{% if stage_report.migration.orphaned_packages %}
<p><strong>Paquetes huérfanos/no necesarios detectados tras la migración (informativo, no se eliminan automáticamente):</strong></p>
<pre>{{ stage_report.migration.orphaned_packages }}</pre>
{% endif %}
{% set _journald = stage_report.migration.journald_persistente | default({}) %}
{% if _journald %}
<p><strong>Journald persistente (evidencia):</strong>
   {% if _journald.ya_estaba_habilitado | default(false) %}ya estaba habilitado antes de esta corrida
   {% elif _journald.se_habilito_ahora | default(false) %}se habilitó recién en esta corrida (<code>Storage=persistent</code> + <code>/var/log/journal</code>), antes del dup real
   {% else %}NO quedó habilitado (revisar manualmente){% endif %}
   <span class="muted"> — permite <code>journalctl --list-boots</code> / <code>journalctl -b -1</code> tras el reinicio.</span></p>
{% endif %}
{% endif %}

{% if stage_report.reboot %}
<h2>Reinicio</h2>
<table>
  <tr><th>Reinicio completado</th><td>{{ stage_report.reboot.completed | default(false) }}</td></tr>
  <tr><th>Reconexión exitosa</th><td>{{ stage_report.reboot.reconnected | default(false) }}</td></tr>
  <tr><th>Servicios deshabilitados permanentemente antes de reiniciar</th><td>{{ (stage_report.reboot.boot_blocking_services_disabled | default([])) | join(', ') or 'ninguno' }}</td></tr>
  {% if stage_report.reboot.postfix_ipv6_root_cause_fixed is defined %}
  <tr><th>Causa raíz de postfix corregida (<code>inet_protocols = ipv4</code> en su configuración)</th><td>{{ stage_report.reboot.postfix_ipv6_root_cause_fixed | default(false) }} <span class="muted">— defensa en profundidad, aunque postfix quede deshabilitado abajo; la unidad de systemd no se modifica, queda como viene por defecto</span></td></tr>
  {% if stage_report.reboot.postfix_disabled_and_killed is defined %}
  <tr><th>postfix deshabilitado, detenido y procesos terminados a la fuerza</th><td>{{ stage_report.reboot.postfix_disabled_and_killed }} <span class="muted">(<code>systemctl disable+stop</code> + <code>killall -9 master pickup qmgr</code> + barrido final <code>pkill -9 -f /usr/lib/postfix</code>)</span></td></tr>
  {% endif %}
  {% if stage_report.reboot.postfix_leftover_processes is defined %}
  <tr><th>Procesos de postfix que quedaron corriendo tras el barrido</th>
      <td>
        {% if (stage_report.reboot.postfix_leftover_processes | trim) | length > 0 %}
          <span class="badge badge-WARNING">quedaron procesos</span>
          <pre>{{ stage_report.reboot.postfix_leftover_processes }}</pre>
        {% else %}
          <span class="badge badge-OK">ninguno</span>
        {% endif %}
      </td></tr>
  {% endif %}
  {% endif %}
  {% set _mok = stage_report.reboot.mok_pending_import | default({}) %}
  {% if _mok %}
  <tr><th>Solicitud MOK pendiente (shim/grub2/kernel)</th>
      <td>
        Secure Boot: <strong>{{ _mok.secure_boot_state | default('NOT_CHECKED') }}</strong>,
        había solicitud pendiente: {{ _mok.habia_solicitud_pendiente | default(false) }}
        {% if _mok.se_revoco_automaticamente %}
          — <span class="badge badge-OK">revocada automáticamente</span> (Secure Boot deshabilitado; evita que "shim" intercepte el próximo arranque pidiendo confirmación manual en consola)
        {% elif _mok.habia_solicitud_pendiente and _mok.secure_boot_state != 'disabled' %}
          — <span class="badge badge-WARNING">NO revocada (Secure Boot habilitado)</span>: el próximo reinicio puede mostrar la pantalla de MokManager esperando confirmación manual en la consola física/del hipervisor
        {% endif %}
      </td></tr>
  {% endif %}
  {% set _grub_debug = stage_report.reboot.grub_debug_boot | default({}) %}
  {% if _grub_debug %}
  <tr><th>Arranque de depuración de GRUB (<code>grub_debug_boot_enabled</code>)</th>
      <td>
        habilitado: {{ _grub_debug.habilitado | default(false) }}
        {% if _grub_debug.se_aplico_ahora %}
          — <span class="badge badge-WARNING">aplicado en esta corrida</span> (GRUB en texto plano, sin splash, systemd en modo detallado — ver la consola del hipervisor en el próximo arranque)
        {% endif %}
      </td></tr>
  {% endif %}
  <tr><th>Hora de inicio del reinicio</th><td>{{ stage_report.reboot.started_at | default('NOT_CHECKED') }}</td></tr>
  <tr><th>Hora de reconexión confirmada</th><td>{{ stage_report.reboot.finished_at | default('NOT_CHECKED') }}</td></tr>
  <tr><th>boot_id antes</th><td><code>{{ stage_report.reboot.boot_id_before | default('NOT_CHECKED') }}</code></td></tr>
  <tr><th>boot_id después</th><td><code>{{ stage_report.reboot.boot_id_after | default('NOT_CHECKED') }}</code></td></tr>
  <tr><th>¿boot_id cambió? (confirma que sí hubo un reinicio real a nivel de kernel)</th>
      <td><span class="badge badge-{{ 'OK' if stage_report.reboot.boot_id_changed == true else ('FAILED' if stage_report.reboot.boot_id_changed == false else 'NOT_CHECKED') }}">{{ stage_report.reboot.boot_id_changed | default('NOT_CHECKED') }}</span></td></tr>
  <tr><th>Duración devuelta por el módulo de Ansible (seg.)</th><td>{{ stage_report.reboot.elapsed_ansible_seconds | default('NOT_CHECKED') }}</td></tr>
  <tr><th>Tiempo de reconexión por reloj de pared (seg., cálculo independiente)</th><td>{{ stage_report.reboot.reconnect_seconds | default('NOT_CHECKED') }}</td></tr>
  <tr><th>Espera post-reinicio a que systemd saliera de "starting"</th>
      <td>
        {% if stage_report.reboot.systemd_settle_timed_out is defined %}
          estado final: <span class="badge badge-{{ 'WARNING' if stage_report.reboot.systemd_settle_timed_out else 'OK' }}">{{ stage_report.reboot.systemd_settle_final_state | default('NOT_CHECKED') }}</span>,
          esperó {{ stage_report.reboot.systemd_settle_waited_seconds | default('NOT_CHECKED') }}s
          {% if stage_report.reboot.systemd_settle_timed_out %} — <strong>seguía en "starting" al agotar el tiempo acotado</strong>{% endif %}
        {% else %}NOT_CHECKED{% endif %}
      </td></tr>
</table>
<p class="muted">Un upgrade real de Service Pack siempre reinicia si el dup se aplicó: no
   existe una opción para omitirlo. Los servicios listados arriba (si hay
   alguno) quedan deshabilitados de forma permanente, no se reinician
   después — ver README sección 8.4/15 para la evidencia real que lo
   justifica. El <code>boot_id</code> y la espera de systemd son
   informativos para diagnóstico (ej. un arranque que se percibió
   "colgado"): nunca decide por sí solo el resultado de la etapa.</p>
{% endif %}

{% set _security_agents = stage_report.security_agents | default({}) %}
{% if (_security_agents.packagekitd_wait_note | default('')) | length > 0 or (_security_agents.started | default([])) | length > 0 %}
<h2>Agentes de seguridad (interferían con Zypper)</h2>
<table>
  <tr><th>Verificación de packagekitd al empezar esta etapa</th><td colspan="3">{{ _security_agents.packagekitd_wait_note | default('N/A') }}</td></tr>
  <tr><th>Servicios reiniciados en esta etapa</th><td colspan="3">{{ _security_agents.started | default([]) | join(', ') or 'ninguno' }}</td></tr>
  <tr><th>Nota</th><td colspan="3">{{ _security_agents.note | default('N/A') }}</td></tr>
</table>
<p class="muted">Ver README sección 8.4 — los servicios se detienen una sola vez
   en Precheck (Nodo 1), no en esta etapa; aquí solo se verifica/espera que
   packagekitd ya esté libre, y al final se asegura que vuelvan a estar activos.</p>
{% endif %}

{% for label, categoria in [('Servicios críticos antes', stage_report.critical_services_before), ('Servicios críticos después', stage_report.critical_services_after)] %}
{% if categoria %}
<h2>{{ label }}</h2>
<table>
  <tr><th>Servicio</th><th>Estado</th></tr>
  {% for svc in categoria %}
  <tr><td>{{ svc.name }}</td><td><span class="badge badge-{{ svc.status }}">{{ svc.status }}</span></td></tr>
  {% endfor %}
</table>
{% endif %}
{% endfor %}

{% for label, gp in [('Validación GeoPOS — antes', stage_report.geopos_before), ('Validación GeoPOS — después', stage_report.geopos_after)] %}
{% if gp %}
<h2>{{ label }}</h2>
<p>Estado global: <span class="badge badge-{{ gp.overall_status }}">{{ gp.overall_status }}</span>
   {% if gp.enabled %}(componente crítico insalubre: {{ gp.critical_unhealthy }}){% endif %}</p>
{% if gp.enabled %}
{% for cat_name, cat in gp.categories.items() %}
<table>
  <tr><th colspan="4">{{ cat_name }} — <span class="badge badge-{{ cat.category_status }}">{{ cat.category_status }}</span></th></tr>
  <tr><th>Nombre</th><th>Crítico</th><th>Estado</th><th>Detalle</th></tr>
  {% for it in cat['items'] %}
  <tr>
    <td>{{ it.name }}</td>
    <td>{{ it.critical }}</td>
    <td><span class="badge badge-{{ it.status }}">{{ it.status }}</span></td>
    <td>{{ it.active_state | default(it.match_count) | default(it.port) | default(it.url) | default('') }}</td>
  </tr>
  {% else %}
  <tr><td colspan="4" class="muted">Sin ítems configurados</td></tr>
  {% endfor %}
</table>
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}

<h2>Persistencia del reporte</h2>
<p>Copia de trabajo: <code>{{ report_local_dir }}/{{ stage_report.hostname }}/</code></p>
<p>Destino persistente definitivo:
  {% if report_destination is search('CHANGE_ME') %}
  <strong>pendiente de configurar</strong> (report_destination = {{ report_destination }})
  — <strong>este reporte todavía NO está garantizado fuera del Execution
  Environment de AWX</strong>, que puede ser efímero incluso para "localhost".
  {% else %}
  {{ report_destination }}
  {% endif %}
</p>

<p class="muted">Generado automáticamente por ansible-sles-upgrade. No contiene secretos.</p>

</body>
</html>
